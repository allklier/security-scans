# Pinned tool versions: the single manifest for every scanner.
# Read by scripts/install-tools.sh (sourced as shell) and scripts/secscan.py.
# KEY=VALUE only, no spaces, no quotes.
#
# Pinning policy: a release must be at least 14 days old when pinned (cool-down
# against hijacked releases, cf. the Trivy compromise GHSA-69fq-xp46-6x23,
# March 2026). Pinned 2026-10-28.

# --- single-binary tools (GitHub releases, verified against the release's own checksum file)
OSV_SCANNER_VERSION=2.7.0
GITLEAKS_VERSION=8.30.1
ACTIONLINT_VERSION=1.7.12
TRIVY_VERSION=0.75.0
SYFT_VERSION=1.54.1

# --- Python tools (installed from tools/requirements.lock with --require-hashes)
# Keep in sync with tools/requirements.in; install-tools.sh refuses to run on drift.
SEMGREP_VERSION=1.180.0
ZIZMOR_VERSION=1.30.1
PYTHON_VERSION=3.12

# --- Semgrep rules: semgrep/semgrep-rules at a fixed commit (git verifies content by SHA).
# Licence: "Semgrep Rules License v1.0" (internal use OK, no redistribution as a service).
SEMGREP_RULES_REPO=https://github.com/semgrep/semgrep-rules
SEMGREP_RULES_COMMIT=9bbf021d0acffa3095fcffd17b2bc7787eb4796d
